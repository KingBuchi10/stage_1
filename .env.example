PORT=3000
NODE_ENV=development

DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=insighta_labs
DATABASE_COLLECTION=profiles
DATABASE_COLLECTION_PREFIX=insighta

PROFILES_SEED_FILE=./data/profiles-2026.json
AUTO_SEED_PROFILES=false

GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback
GITHUB_WEB_REDIRECT_URIS=http://localhost:4173/auth/callback,http://127.0.0.1:4173/auth/callback
GITHUB_CLI_REDIRECT_URIS=http://127.0.0.1:8787/callback

ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

JWT_SECRET=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=1800
OAUTH_STATE_TTL_SECONDS=600
AUTHORIZATION_CODE_TTL_SECONDS=60

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

ADMIN_GITHUB_USERS=your-admin-github-login
ANALYST_GITHUB_USERS=your-analyst-github-login
ALLOW_UNLISTED_ANALYSTS=false
